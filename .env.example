# Neon / Cloud PostgreSQL Connection String Example
DATABASE_URL="postgresql://user:password@your-cloud-host.neon.tech/neondb?sslmode=require"
PORT=8000

# Secret used to sign session tokens (HMAC-SHA256).
# REQUIRED in production. If unset the server generates an ephemeral secret at
# boot, which means every restart invalidates all active sessions.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-32-byte-random-hex-string"

# AES-256-GCM key for encrypting NID/BRC identity fields (REQ-14, PDPA 2026).
# REQUIRED for the identity vault. Without it the vault endpoints refuse to
# store data rather than silently saving plaintext.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="replace-with-64-hex-chars"

# HMAC key for the tamper-evident audit chain (Cybersecurity Act 2023).
# REQUIRED for audit logging. Without it writeAudit() REFUSES to append entries
# rather than writing an unkeyed chain that anyone with database write access
# could recompute — so the audit trail is silently empty until this is set.
# Keep it out of the database and rotate it separately from ENCRYPTION_KEY;
# rotating it makes entries written under the old key unverifiable.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUDIT_HMAC_KEY="replace-with-64-hex-chars"

# Shared secret authenticating the scheduled sweep endpoints (/api/cron/*).
# These run the 30-day PDPA deletion purge and the event/task roll-forward
# sweeps. They are NOT authenticated by a user bearer token, because a
# scheduler has no user session — this secret is the whole access control, so
# treat it like a password and never commit the real value.
# Without it the sweeps are unreachable by a scheduler and the 30-day deletion
# promise only executes when a super admin runs it by hand.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET="replace-with-64-hex-chars"
