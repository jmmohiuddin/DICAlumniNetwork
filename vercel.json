{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    { "src": "/(.*)", "dest": "/api/index.js" }
  ],
  "crons": [
    { "path": "/api/cron/purge-deletions", "schedule": "0 3 * * *" },
    { "path": "/api/cron/event-status", "schedule": "0 * * * *" },
    { "path": "/api/cron/task-reminders", "schedule": "0 7 * * *" }
  ]
}
